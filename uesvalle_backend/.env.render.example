# ===========================================
# Variables de Entorno para Render (Backend)
# ===========================================

# Django
SECRET_KEY=genera-una-clave-secreta-segura-aqui
DEBUG=False
PYTHON_VERSION=3.11.6

# PostgreSQL - Render proporciona DATABASE_URL automáticamente
# Copia el "Internal Database URL" de tu PostgreSQL en Render
DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS - Agregar tu dominio de Netlify
CORS_ALLOWED_ORIGINS=https://tu-app.netlify.app

# Redis para Celery (opcional - solo si usas Background Worker)
CELERY_BROKER_URL=redis://red-xxxxx:6379
CELERY_RESULT_BACKEND=redis://red-xxxxx:6379

# MySQL (si lo necesitas para ETL - conexión externa)
MYSQL_DB=source_db
MYSQL_USER=mysql_user
MYSQL_PASSWORD=mysql_pass
MYSQL_HOST=localhost
MYSQL_PORT=3306
